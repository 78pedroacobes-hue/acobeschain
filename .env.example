# Configuración soberana de Arquitectura Records LLC
LABEL_NAME="Arquitectura Records LLC"
PRIMARY_ARTIST='Acobes "El Arquitecto"'

# Prefijo ISRC oficial de 3 caracteres emitido por la US ISRC Agency (RIAA)
# Ejemplo: si tu prefijo es A1B, los códigos saldrán como US-A1B-26-00001
ISRC_COUNTRY="US"
ISRC_REGISTRANT="XXX"
ISRC_YEAR="26"

# DDEX Party ID (DPID) asignado al completar el registro gratuito en ddex.net
DDEX_DPID="PADPIDA_PENDIENTE_REGISTRO"

# Opcional: Prefijo UPC de GS1 US
GS1_UPC_PREFIX=""
